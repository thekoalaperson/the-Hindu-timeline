{
  "name": "the-hindu-timeline-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "node scripts/graph.mjs && node scripts/events.mjs && node scripts/media.mjs && node scripts/og.mjs",
    "predev": "npm run generate",
    "dev": "astro dev",
    "prebuild": "npm run generate",
    "build": "astro build && pagefind --site dist",
    "build:nosearch": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test \"test/*.test.mjs\"",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.0.1",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "@types/three": "^0.185.4",
    "astro": "7.3.8",
    "hast-util-to-string": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0",
    "sharp": "0.35.5",
    "three": "^0.185.1",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  }
}
