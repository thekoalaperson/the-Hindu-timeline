---
/**
 * StoryRail.astro — the page's own chapters, in a sticky rail.
 *
 * Server-rendered from the H2s the markdown already has, so it is a working
 * table of contents with no JavaScript at all. JS adds two things: the hairline
 * progress bar, and `aria-current` following the reader down the page.
 *
 * It only appears when a page has three or more H2s — below that the rail is
 * chrome pretending to be structure.
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  /** Below this many H2s the rail is not worth its height. */
  min?: number;
}
const { headings, min = 3 } = Astro.props;
const items = headings.filter((h) => h.depth === 2 && h.slug && h.text.trim());
const show = items.length >= min;
---

{
  show && (
    <nav class="story-rail" aria-label="In this story" data-story-rail>
      <div class="story-rail-track" data-rail-track>
        {/* The label is its own element so `text-overflow: ellipsis` has a block
            box to act on — on the flex item itself it does nothing, and a long
            chapter title was hard-cut mid-word at the tab's edge. */}
        {items.map((h) => (
          <a class="story-rail-item" href={`#${h.slug}`} data-rail-link={h.slug} title={h.text}>
            <span class="story-rail-text">{h.text}</span>
          </a>
        ))}
      </div>
      <div class="story-progress" aria-hidden="true">
        <i data-progress-bar />
      </div>
    </nav>
  )
}

<script>
  const rail = document.querySelector<HTMLElement>('[data-story-rail]');
  if (rail) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
    const bar = rail.querySelector<HTMLElement>('[data-progress-bar]');
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const targets = links
      .map((a) => ({ a, el: document.getElementById(a.dataset.railLink || '') }))
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => Boolean(t.el));

    let current: HTMLAnchorElement | null = null;
    function mark(a: HTMLAnchorElement | null): void {
      if (a === current) return;
      current?.removeAttribute('aria-current');
      current = a;
      if (!a) return;
      a.setAttribute('aria-current', 'true');
      /* Keep the live section in view in the horizontal scroller — but never
         steal the vertical scroll position while doing it. */
      if (track) {
        const want = a.offsetLeft - track.clientWidth / 2 + a.clientWidth / 2;
        track.scrollTo({ left: Math.max(0, want), behavior: 'auto' });
      }
    }

    /* One rAF-throttled scroll handler rather than an IntersectionObserver per
       heading: with 30+ H2s on the long corpus pages the observer callbacks
       were the more expensive of the two, and this also gives the progress bar
       its number for free. */
    let ticking = false;
    function update(): void {
      ticking = false;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      if (bar) {
        const pct = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        bar.style.width = `${(pct * 100).toFixed(1)}%`;
      }
      const line = rail!.getBoundingClientRect().bottom + 8;
      let found: HTMLAnchorElement | null = null;
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= line) found = t.a;
        else break;
      }
      mark(found ?? targets[0]?.a ?? null);
    }
    function onScroll(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
