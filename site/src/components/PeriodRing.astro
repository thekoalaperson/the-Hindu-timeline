---
/**
 * PeriodRing — the mahāyuga as a ring, with the page's own period lit.
 * The four yuga arcs keep their 4:3:2:1 proportion; the non-yuga periods
 * (before time, the earlier and future manvantaras, cross-yuga) light the
 * outer band instead, because they sit outside this mahāyuga.
 */
interface Props {
  period?: string | null;
  size?: number;
  class?: string;
}
const { period = null, size = 60, class: cls = '' } = Astro.props;

const C = 50;
const rad = (d: number) => (d * Math.PI) / 180;
const pt = (d: number, r: number) => [
  +(C + r * Math.cos(rad(d))).toFixed(2),
  +(C + r * Math.sin(rad(d))).toFixed(2),
];
const arc = (from: number, to: number, r: number) => {
  const [x1, y1] = pt(from, r);
  const [x2, y2] = pt(to, r);
  return `M${x1} ${y1}A${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${x2} ${y2}`;
};

const YUGAS = [
  { slug: 'satya-yuga', from: -90, to: 54, hue: 'var(--yuga-satya)' },
  { slug: 'treta-yuga', from: 54, to: 162, hue: 'var(--yuga-treta)' },
  { slug: 'dvapara-yuga', from: 162, to: 234, hue: 'var(--yuga-dvapara)' },
  { slug: 'kali-yuga-scriptural', from: 234, to: 270, hue: 'var(--yuga-kali)' },
];
const kaliish = period === 'kali-yuga-history' ? 'kali-yuga-scriptural' : period;
const outer = period && !YUGAS.some((y) => y.slug === kaliish);
const [nx, ny] = pt(234.4, 40);
---

<svg
  class={`period-ring ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="50" cy="50" r="44" stroke={outer ? 'var(--period)' : 'var(--rule)'} stroke-width={outer ? 3 : 1} />
  {
    YUGAS.map((y) => (
      <path
        d={arc(y.from, y.to, 30)}
        stroke={y.slug === kaliish ? 'var(--period)' : y.hue}
        stroke-width={y.slug === kaliish ? 6 : 2.4}
        opacity={!period || y.slug === kaliish ? 1 : 0.4}
      />
    ))
  }
  <line x1="50" y1="50" x2={nx} y2={ny} stroke="var(--rubric)" stroke-width="1.3" stroke-linecap="round" />
  <circle cx="50" cy="50" r="3.4" fill="var(--paper)" stroke="var(--rubric)" stroke-width="1" />
</svg>
