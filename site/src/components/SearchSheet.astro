---
/**
 * The search sheet — the bottom bar's "Search" on every inner page.
 *
 * It renders the same panel as /search/ (src/pages/search/_Panel.astro) so
 * there is exactly one search engine on the site: the sheet and the page find
 * the same things, in the same order, with the same pinned direct answer at
 * the top. Importing a partial out of src/pages/ is deliberate — the panel is
 * the search page's own body, and an underscore-prefixed file there is not a
 * route.
 */
import SearchPanel from '../pages/search/_Panel.astro';
import Icon from './Icon.astro';
---

<dialog class="sheet sheet--full" id="sheet-search" aria-labelledby="sheet-search-title">
  <div class="sheet-grip" aria-hidden="true"><Icon name="roundel" size={20} /></div>
  <div class="sheet-head">
    <h2 class="sheet-title" id="sheet-search-title">Search</h2>
    <button type="button" class="sheet-close" data-sheet-close aria-label="Close search">Close</button>
  </div>
  <div class="sheet-body">
    <SearchPanel id="sheet-search-panel" />
  </div>
</dialog>
