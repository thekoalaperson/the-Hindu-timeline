---
/**
 * PlainToggle.astro — the one-tap reading-mode switch.
 *
 * Two mounts, one behaviour: the header (always visible, 44px) and the Page
 * sheet (where the label can be a full sentence). Both carry
 * `[data-plain-toggle]`; `PlainScript.astro` wires every one of them and keeps
 * their `aria-pressed` in sync, so neither mount owns any state.
 *
 * `aria-pressed` is set here to plain — the default since D-plain-default
 * (BRIEF v4 §4 W3e) — and corrected by `PlainScript.astro` for the reader who
 * turned it off. The attribute stamp itself happens before paint in
 * `Base.astro`, so nobody sees a flash of the wrong mode.
 *
 * The `title`/`aria-label` say what a *tap* gets you, not what mode you are
 * in: with plain English on by default, "Plain English" alone left the
 * scholarly text — IAST, citations, variants — undiscoverable. PlainScript
 * rewrites both strings on every toggle.
 */
interface Props {
  /** 'header' is icon-first and terse; 'sheet' is a full row. */
  variant?: 'header' | 'sheet';
}
const { variant = 'header' } = Astro.props;
---

<button
  type="button"
  class={variant === 'sheet' ? 'plain-toggle plain-toggle-sheet' : 'plain-toggle'}
  data-plain-toggle
  aria-pressed="true"
  aria-label="Switch to the scholarly text — IAST spellings, citations and variants"
  title="Switch to the scholarly text — IAST spellings, citations and variants"
>
  <span class="pt-glyph" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M2.9 6.1h8.6M7.2 4.4v1.7M9.6 6.1c-.5 3.7-3 6.6-6.7 7.8" />
      <path d="M4.9 9.6c1.1 2.1 2.9 3.7 5.2 4.3" />
      <path d="m12.6 19.6 4-9.4 4 9.4M14.1 16.5h5" />
    </svg>
  </span>
  <span class="pt-label">
    <span class="pt-label-full">Plain English</span>
    <span class="pt-label-short" aria-hidden="true">Plain</span>
  </span>
  {variant === 'sheet' && <span class="pt-state" data-plain-state>On</span>}
</button>
