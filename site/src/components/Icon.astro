---
/**
 * Icon.astro — the whole icon set, drawn here, in one continuous hairline
 * stroke each (the Chola-bronze contour lesson from R4 §1.3). No icon font,
 * no library, no filled glyphs, and nothing figurative or devotional.
 */
interface Props {
  name: 'clock' | 'browse' | 'stories' | 'search' | 'films' | 'roundel' | 'close' | 'share' | 'sun' | 'mark';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.15,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true' as const,
  focusable: 'false',
  class: cls,
};
---

{
  name === 'clock' && (
    <svg {...common}>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.4" stroke-width="0.75" opacity="0.65" />
      <path d="M12 12 17 7.4" stroke-width="1.35" />
    </svg>
  )
}
{
  name === 'browse' && (
    <svg {...common}>
      <path d="M8.5 6.6h12M8.5 12h12M8.5 17.4h8.4" />
      <circle cx="4.4" cy="12" r="1.5" stroke-width="0.95" />
      <path d="M4.4 6.6h.01M4.4 17.4h.01" />
    </svg>
  )
}
{
  /* A palm-leaf folio held open — the manuscript this site is, not a
     paperback. One hairline contour, a spine tie, and the two ruled lines
     that stand for text. */
  name === 'stories' && (
    <svg {...common}>
      <path d="M12 7.1c-2-1.4-4.3-1.9-7.2-1.6a.7.7 0 0 0-.6.7v9.6c0 .4.3.7.7.7 2.7-.2 4.9.3 7.1 1.6 2.2-1.3 4.4-1.8 7.1-1.6.4 0 .7-.3.7-.7V6.2a.7.7 0 0 0-.6-.7c-2.9-.3-5.2.2-7.2 1.6z" />
      <path d="M12 7.1V18" stroke-width="0.85" opacity="0.7" />
      <path d="M6.6 9.6h3.1M6.6 12.4h3.1M14.3 9.6h3.1M14.3 12.4h3.1" stroke-width="0.8" opacity="0.6" />
    </svg>
  )
}
{
  name === 'search' && (
    <svg {...common}>
      <circle cx="10.6" cy="10.6" r="6.4" />
      <path d="M15.4 15.4 20 20" />
    </svg>
  )
}
{
  name === 'films' && (
    <svg {...common}>
      <rect x="2.8" y="6" width="18.4" height="12" rx="1" />
      <path d="M10.2 9.6 15 12l-4.8 2.4z" />
    </svg>
  )
}
{
  name === 'roundel' && (
    <svg {...common}>
      <circle cx="12" cy="12" r="9" stroke-width="0.9" />
      <circle cx="12" cy="12" r="3.2" stroke-width="0.9" />
    </svg>
  )
}
{
  name === 'mark' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 12 12"
      fill="none"
      aria-hidden="true"
      focusable="false"
      class={cls}
    >
      <circle cx="6" cy="6" r="4.6" stroke="currentColor" stroke-width="1.1" />
      <circle cx="6" cy="6" r="1.3" fill="currentColor" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg {...common}>
      <path d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5" />
    </svg>
  )
}
{
  name === 'share' && (
    <svg {...common}>
      <path d="M12 15.5V4.2M8.4 7.6 12 4l3.6 3.6" />
      <path d="M5.5 12.4v6.4a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-6.4" />
    </svg>
  )
}
{
  name === 'sun' && (
    <svg {...common}>
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
    </svg>
  )
}
