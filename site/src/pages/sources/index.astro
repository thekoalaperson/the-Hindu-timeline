---
import { getEntry, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { nodeFor } from '../../lib/graph.ts';

const entry = await getEntry('corpus', 'SOURCES.md');
if (!entry) throw new Error('SOURCES.md is missing from the corpus collection.');
const node = nodeFor('SOURCES.md')!;
const { Content, headings } = await render(entry);
---

<Article node={node} headings={headings} page="sources">
  <Content />
</Article>
