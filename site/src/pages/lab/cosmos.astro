---
/**
 * /lab/cosmos/ — concept A, "The Cosmos".
 *
 * A painted, explorable bhuvana-kośa: Meru on the axis, the sapta-dvīpa rings
 * on the disc, the seven lokas stacked above and the seven pātālas below, with
 * every film hung as a luminous leaf at the place its story happens.
 *
 * Everything structural on this page is read off the corpus — see world.ts for
 * the citations. The page renders the whole thing twice: once as a JSON payload
 * for the WebGL scene, and once as a plain illustrated scroll that is what you
 * get with no WebGL (and what a screen reader gets either way).
 */
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/tiro-devanagari-hindi/400.css';
import { cardPoster } from '../../lib/films.ts';
import periods from '../../generated/periods.json';
import {
  AGE_LIGHT,
  DEFAULT_KEY,
  DEFAULT_SKY,
  DISC_EDGE,
  LADDER,
  LEAF_NAME,
  PLACES,
  REALMS,
  RINGS,
  placesByRealm,
} from '../../lab/cosmos/world.ts';
import '../../lab/cosmos/cosmos.css';

const periodList = periods as { slug: string; short: string; route: string; intro: string }[];

const ages = periodList.map((p) => {
  const light = AGE_LIGHT[p.slug] ?? { sky: DEFAULT_SKY, key: DEFAULT_KEY, line: p.intro };
  return { slug: p.slug, short: p.short, route: p.route, ...light };
});

/** Everything the scene needs, serialised once. ~30 kB. */
const payload = {
  discEdge: DISC_EDGE,
  defaultSky: DEFAULT_SKY,
  defaultKey: DEFAULT_KEY,
  rings: RINGS,
  realms: REALMS.map((r) => ({
    id: r.id,
    name: r.name,
    gloss: r.gloss,
    y: r.y,
    plate: r.plate,
    band: r.band,
    color: r.color,
    route: r.route,
    cite: r.cite,
    tick: r.tick,
  })),
  ages,
  places: PLACES.map((p) => {
    const poster = cardPoster(p.film);
    const still = p.film.stills[0];
    return {
      slug: p.slug,
      title: p.film.title.en,
      /** What the label in the sky says: the name, not the whole headline. */
      short: LEAF_NAME[p.slug] ?? p.film.title.en.split(/\s+[—–]\s+/)[0] ?? p.film.title.en,
      hi: p.film.title.hi,
      summary: p.film.summary,
      where: p.where,
      realmId: p.realm.id,
      realmName: p.realmName,
      realmGloss: p.realm.gloss,
      realmRoute: p.realm.route,
      cite: p.realm.cite,
      x: Number(p.x.toFixed(3)),
      y: Number(p.y.toFixed(3)),
      z: Number(p.z.toFixed(3)),
      period: p.periodSlug,
      periodName: p.periodName,
      art400: poster ? poster.src.replace(/-800\.webp$/, '-400.webp') : null,
      art800: poster ? poster.src : null,
      alt: still?.alt ?? p.film.title.en,
      videoId: p.film.isPublic ? p.film.yt.videoId : null,
      isPublic: p.film.isPublic,
      duration: p.film.duration,
      filmRoute: p.film.route,
      corpusRoute: p.film.corpus[0]?.route ?? null,
      corpusTitle: p.film.corpus[0]?.title ?? null,
    };
  }),
};

const byRealm = placesByRealm();
const placed = payload.places;
const publishedCount = placed.filter((p) => p.isPublic).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0806" />
    <title>The Cosmos — The Hindu Timeline</title>
    <meta
      name="description"
      content="The bhuvana-kośa as a place you can travel: Meru, the seven dvīpas, the lokas above and the pātālas below, with every film at the place its story happens."
    />
  </head>
  <body>
    <script is:inline>
      // Decide before first paint which of the two experiences the page is.
      try {
        var c = document.createElement('canvas');
        var gl = c.getContext('webgl2') || c.getContext('webgl') || c.getContext('experimental-webgl');
        if (gl && typeof gl.getParameter === 'function') document.body.classList.add('cos-gl');
      } catch (e) {
        /* no WebGL — the scroll below is the page */
      }
    </script>

    <a class="cos-skip" href="#cos-all">Skip to a list of every place</a>

    <div class="cos-stage" id="cos-stage">
      <canvas class="cos-canvas" id="cos-canvas" tabindex="-1" aria-label="The cosmos — drag to travel, tap a glowing leaf to open its story"></canvas>
      <div class="cos-vignette"></div>
      <div class="cos-labels" id="cos-labels" aria-hidden="true"></div>

      <div class="cos-overture" id="cos-overture" aria-hidden="true">
        <p>
          Fourteen worlds, one egg.<span>The Hindu Timeline</span>
        </p>
      </div>

      <header class="cos-top">
        <p class="cos-wordmark">The Cosmos<span>{publishedCount} films · {placed.length} places</span></p>
        <button class="cos-btn" id="cos-open-list" type="button">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <path d="M2 4h12M2 8h12M2 12h12" />
          </svg>
          List all
        </button>
      </header>

      <nav class="cos-ladder" id="cos-ladder" aria-label="The fourteen worlds">
        {
          LADDER.map((r) => (
            <button class="cos-tick" type="button" data-realm={r.id} data-band={r.band} aria-current="false">
              <span>{r.tick}</span>
            </button>
          ))
        }
      </nav>

      <div class="cos-rail">
        <p class="cos-rail-line" id="cos-rail-line">
          <b>The whole egg.</b> Drag to turn and to climb; pinch to come closer.
        </p>
        <div class="cos-rail-strip" id="cos-rail-strip" role="group" aria-label="Ages">
          <button class="cos-age" type="button" data-age="" aria-pressed="true"><i></i>All ages</button>
          {
            ages.map((a) => (
              <button class="cos-age" type="button" data-age={a.slug} aria-pressed="false" style={`--dot:${a.key}`}>
                <i />
                {a.short}
              </button>
            ))
          }
        </div>
      </div>

      <div class="cos-hotspots" id="cos-hotspots">
        {
          placed.map((p) => (
            <button type="button" data-slug={p.slug}>
              {p.title} — {p.realmName}
            </button>
          ))
        }
      </div>

      <div class="cos-hint" id="cos-hint" hidden>
        <div class="cos-hint-card">
          <h2>You are outside the egg, looking in.</h2>
          <ul>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 20c0-5 3-9 7-9s7 4 7 9" /><path d="M16 11V5" /><path d="M12.5 8 16 4.5 19.5 8" /><path d="M9 20h14" /></svg>
              <span>Drag up and down to climb the worlds, sideways to turn.</span>
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="6" /><path d="M16 4v3M16 25v3M4 16h3M25 16h3" /></svg>
              <span>Pinch, or roll the wheel, to come closer.</span>
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="9" width="20" height="13" rx="2" /><path d="M13 14.5 19 16l-6 1.5z" fill="currentColor" stroke="none" /></svg>
              <span>Every glowing leaf is a film. Touch one.</span>
            </li>
          </ul>
          <button class="cos-btn" id="cos-hint-go" type="button">Begin</button>
        </div>
      </div>

      <aside class="cos-panel" id="cos-panel" hidden role="dialog" aria-modal="false" aria-labelledby="cos-panel-title">
        <div class="cos-panel-grip"></div>
        <button class="cos-panel-close" id="cos-panel-close" type="button" aria-label="Close and go back">✕</button>
        <div class="cos-panel-scroll">
          <div class="cos-art" id="cos-art">
            <img id="cos-art-img" alt="" width="800" height="450" />
            <button class="cos-play" id="cos-play" type="button" aria-label="Watch the film"><em></em></button>
          </div>
          <div class="cos-panel-body">
            <p class="cos-where" id="cos-where"></p>
            <h2 id="cos-panel-title"></h2>
            <p class="cos-hi cos-lang-hi" id="cos-hi"></p>
            <p class="cos-sum" id="cos-sum"></p>
            <p class="cos-note" id="cos-note"></p>
            <div class="cos-links" id="cos-links"></div>
          </div>
        </div>
      </aside>
    </div>

    <dialog class="cos-list" id="cos-list" aria-label="Everything in the cosmos">
      <form method="dialog"><button class="cos-btn" type="submit">Close</button></form>
      <div class="cos-list-inner">
        <h2>Everything placed in the cosmos</h2>
        <p style="margin:0;color:var(--cos-ink-3);font-size:0.86rem;">
          {placed.length} films, from Vaikuṇṭha down to the womb-ocean. Top to bottom.
        </p>
        {
          byRealm.map(({ realm, places }) => (
            <section class="cos-realm-block">
              <h3><a href={realm.route}>{realm.name}</a></h3>
              <p>{realm.gloss}</p>
              {places.length === 0 ? (
                <p class="cos-fb-empty">No film here yet.</p>
              ) : (
                <ul>
                  {places.map((p) => (
                    <li>
                      <a href={p.film.route}>
                        {p.film.title.en}
                        <em>
                          {p.periodName}
                          {p.film.isPublic ? '' : ' · coming soon'}
                        </em>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </dialog>

    <main class="cos-fallback" id="cos-all">
      <div class="cos-fb-head">
        <h1>The Cosmos</h1>
        <p>
          The bhuvana-kośa top to bottom — Vaikuṇṭha, the seven upper worlds, Meru and the ring-continents of
          the disc, then the seven pātālas and the womb-ocean beneath. Each film sits at the place its story
          happens.
        </p>
      </div>
      {
        byRealm.map(({ realm, places }) => (
          <section class="cos-fb-realm">
            <h2>
              {realm.name}
              <i>{realm.band === 'upper' ? 'above' : realm.band === 'lower' ? 'below' : 'the disc'}</i>
            </h2>
            <p>
              {realm.gloss} <a href={realm.route}>{realm.cite}</a>
            </p>
            {places.length === 0 ? (
              <p class="cos-fb-empty">No film here yet.</p>
            ) : (
              <ul class="cos-fb-grid">
                {places.map((p) => {
                  const poster = cardPoster(p.film);
                  return (
                    <li>
                      <a class={`cos-fb-card${p.film.isPublic ? '' : ' is-soon'}`} href={p.film.route}>
                        {poster && (
                          <img
                            src={poster.src}
                            srcset={poster.srcset ?? undefined}
                            sizes="(min-width: 700px) 220px, 45vw"
                            alt={p.film.stills[0]?.alt ?? p.film.title.en}
                            width={poster.width}
                            height={poster.height}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <b>{p.film.title.en}</b>
                        <em>{p.where}</em>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))
      }
    </main>

    <script type="application/json" id="cos-data" is:inline set:html={JSON.stringify(payload)} />
    <script>
      import { boot } from '../../lab/cosmos/scene.ts';
      boot();
    </script>
  </body>
</html>
